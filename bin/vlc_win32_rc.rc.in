/* VLCFlix: the version Windows shows for vlcflix.exe is VLCFlix's own (FLIX_VERSION) */
#define VERSION_NUMBER @FLIX_VERSION_MAJOR@,@FLIX_VERSION_MINOR@,@FLIX_VERSION_REVISION@,0
#define VERSION_NUMBER_STR "@FLIX_VERSION@"

#include <winuser.h>

VLC_ICON ICON "vlc.ico"

1 VERSIONINFO
FILETYPE 1
FILEOS 4
PRODUCTVERSION VERSION_NUMBER
FILEVERSION VERSION_NUMBER
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName", "VLCFlix"
      VALUE "ProductName", "VLCFlix"
      VALUE "ProductVersion", VERSION_NUMBER_STR
      VALUE "InternalName", "vlcflix"
      VALUE "OriginalFilename", "vlcflix.exe"
      VALUE "FileVersion", "@FLIX_VERSION@"
      VALUE "FileDescription", "VLCFlix"
      VALUE "LegalCopyright", "Copyright \251 @COPYRIGHT_YEARS@ VideoLAN and VLC Authors"
      VALUE "LegalTrademarks", "VLC media player, VideoLAN and x264 are registered trademarks from VideoLAN"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "vlcflix.exe.manifest"
